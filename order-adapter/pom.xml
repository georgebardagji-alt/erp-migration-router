<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.bardaghji</groupId>
        <artifactId>erp-migration-router</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <!-- groupId and version are inherited from the root POM -->
    <artifactId>order-adapter</artifactId>
    <name>order-adapter</name>
    <description>Calls one ERP, maps it to the canonical model and records every call (runs as adapter-ecc and adapter-s4)</description>

    <dependencies>
        <dependency>
            <groupId>com.bardaghji</groupId>
            <artifactId>canonical-model</artifactId>
            <!-- no version: managed in the root POM -->
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Makes this module a runnable Spring Boot application (fat jar) -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
